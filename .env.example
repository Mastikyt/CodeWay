# Адрес backend API.
# Пусто/не задано — в dev используется http://localhost:3001 (Vite proxy),
# в production-сборке запросы идут на тот же origin, что и сайт.
# Для внешнего API укажите полный адрес без завершающего слэша, например:
# VITE_API_URL=https://api.example.com
VITE_API_URL=

# Секрет для подписи токенов авторизации (server.js, HMAC-SHA256).
# Пусто — сервер сгенерирует случайный ключ при старте, и все сессии
# станут невалидными после перезапуска. На демонстрации это неважно,
# для постоянной работы задайте длинную случайную строку.
TOKEN_SECRET=
